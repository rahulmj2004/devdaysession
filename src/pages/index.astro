---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getCatalogSummary } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const summary = await getCatalogSummary(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 grid gap-4 sm:grid-cols-2" data-testid="catalog-summary" aria-label="Catalog summary">
      <div class="rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-400">Games in catalog</p>
        <p class="mt-3 text-3xl font-semibold text-slate-100" data-testid="catalog-total-games">
          {summary.totalGames}
        </p>
      </div>

      <div class="rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-400">Average rating</p>
        <p class="mt-3 text-3xl font-semibold text-slate-100" data-testid="catalog-average-rating">
          {summary.averageRating === null ? 'No rated games yet' : `${summary.averageRating.toFixed(1)}/5`}
        </p>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
